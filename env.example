# Example environment variables
# Copy this file to .env.local and fill in your values

# Supabase Configuration (REQUIRED)
# Get these from your Supabase project dashboard: https://app.supabase.com
# Go to Settings → API to find these values
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (OPTIONAL but RECOMMENDED for duplicate family name checking)
# This allows the API to bypass RLS for validation checks
# Get this from Settings → API → service_role key (keep it secret!)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Public environment variables (accessible in browser)
# NEXT_PUBLIC_API_URL=https://api.example.com

# Server-only environment variables
# DATABASE_URL=postgresql://...
# SECRET_KEY=your-secret-key-here
